# Optional local overrides. Copy to .env and fill in only what you need.
# This file is a template and is safe to commit. Never commit a real .env.

# Full path to the SUMO executable, if it is not on your PATH.
# Windows:      SUMO_BIN=C:\Program Files\Eclipse SUMO\Sumo-1.27.1\bin\sumo.exe
# macOS/Linux:  SUMO_BIN=/usr/local/bin/sumo
SUMO_BIN=

# SUMO installation root (the folder holding bin/, data/, tools/).
# Needed on Windows if SUMO reports that it cannot find its data files.
SUMO_HOME=

# Folder holding the SUMO network. Defaults to the calgary/ folder next to
# this file, so leave blank unless you move the model elsewhere.
CALGARY_DIR=