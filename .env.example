# Copy this file to .env (same folder) and paste your own keys after the = signs.
# .env is in .gitignore, so your keys never get committed. Never put a real key in this file.

# Claude: crew-update parsing, briefings, and the caller chat. Without it, rule-based fallbacks run.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs (optional): lets the caller speak, and the agent answer in a natural voice.
# Without it the chat is typed, and replies use your browser's built-in voice.
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
