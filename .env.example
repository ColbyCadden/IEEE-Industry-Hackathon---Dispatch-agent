# Copy this file to .env (same folder) and paste your own keys after the = signs.
# .env is in .gitignore, so your keys never get committed. Never put a real key in this file.

# Claude: crew-update parsing and briefings. Without it, rule-based fallbacks run.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs (optional): report an update on a voice call from the Report an update box.
# Without it the call button is hidden and typing works as before. Get a key at https://elevenlabs.io/app/settings/api-keys
# (it needs Text to Speech and Speech to Text access). ELEVENLABS_VOICE_ID picks a different voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
